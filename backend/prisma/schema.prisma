// =============================================================================
// CRM PHÒNG KHÁM PHẪU THUẬT THẨM MỸ — SCHEMA ĐANG CHẠY (Giai đoạn 1 / MVP)
// =============================================================================
//
// Nguồn thiết kế:
//   - crm-app/docs/schema_tmv.prisma            (bản nháp đầy đủ ~140 model, PostgreSQL)
//   - wiki/Phong_Kham_Tham_My/Kien_Truc_CRM_Tham_My.md  (mục 7 — phạm vi Giai đoạn 1)
//   - crm-app/docs/prototype_tmv.html           (màn hình)
//
// Tệp này là tập con Giai đoạn 1 của bản nháp đó, đã hạ xuống SQLite để chạy
// được ngay trên máy không có PostgreSQL/Docker (xem README). Quy ước giữ
// nguyên để đổi sang PostgreSQL chỉ là việc đổi `provider` + thay các cột
// String-enum bằng enum thật:
//
//   1. SQLite không có enum  -> các cột trạng thái là String, giá trị hợp lệ
//      khai báo tại src/types/enums.ts và ép bằng zod ở tầng route.
//   2. SQLite không có Decimal an toàn -> TIỀN LƯU BẰNG Int, ĐƠN VỊ ĐỒNG
//      (VND không dùng phần lẻ). TUYỆT ĐỐI KHÔNG dùng Float cho tiền.
//   3. SQLite không có array -> các trường danh sách lưu JSON dạng String.
//   4. Mọi bảng nghiệp vụ theo cơ sở đều có branchId.
//   5. Bảng y khoa (MedicalRecord, ConsentForm, PhotoSet, PhotoAsset,
//      ProcedureRecord) có branchId NOT NULL và bị CÁCH LY theo cơ sở ở tầng
//      truy vấn (src/lib/scope.ts) — trả 404 thay vì 403 khi vượt phạm vi.
//   6. onDelete: Restrict cho dữ liệu y tế/tài chính, Cascade cho dữ liệu con
//      thuần tuý, SetNull cho tham chiếu người dùng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. TỔ CHỨC — CƠ SỞ, PHÒNG BAN
// =============================================================================

model Branch {
  id              String   @id @default(uuid())
  code            String   @unique // PK_TMV, PK_SAN
  name            String
  shortName       String?
  address         String?
  phone           String?
  timezone        String   @default("Asia/Ho_Chi_Minh")
  active          Boolean  @default(true)
  /// F24: link bản đồ, chỉ dẫn gửi xe, chỉ dẫn toà nhà (sảnh, tầng), ảnh mặt tiền.
  mapUrl          String?
  parkingGuide    String?
  buildingGuide   String?
  facadePhotoUrl  String?
  /// F25: tài khoản nhận cọc của cơ sở (trống thì lấy Cài đặt hệ thống).
  bankBin         String?
  bankAccountNo   String?
  bankAccountName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  departments          Department[]
  userBranches         UserBranch[]
  customerLinks        CustomerBranchLink[]
  rooms                Room[]
  appointments         Appointment[]
  visits               Visit[]
  conversations        Conversation[]
  zaloConfigs          ZaloOAConfig[]
  leads                Lead[]
  campaigns            Campaign[]
  servicePrices        ServicePrice[]
  quotations           Quotation[]
  contracts            Contract[]
  invoices             Invoice[]
  payments             Payment[]
  medicalRecords       MedicalRecord[]
  consentForms         ConsentForm[]
  photoSets            PhotoSet[]
  procedures           ProcedureRecord[]
  shiftTemplates       ShiftTemplate[]
  shiftAssignments     ShiftAssignment[]
  auditLogs            AuditLog[]
  dataAccessLogs       DataAccessLog[]
  tasks                Task[]
  warehouses           Warehouse[]
  productUsages        ProductUsage[]
  purchaseOrders       PurchaseOrder[]
  attendances          Attendance[]
  leaveRequests        LeaveRequest[]
  commissionRules      CommissionRule[]
  commissionEntries    CommissionEntry[]
  kpiTargets           KpiTarget[]
  kpiActuals           KpiActual[]
  payrollPeriods       PayrollPeriod[]
  consultationSessions ConsultationSession[]
  treatmentPlans       TreatmentPlan[]
  caseStudies          CaseStudy[]
  pancakeConfigs       PancakeConfig[]
  pancakePages         PancakePage[]
  stockTransfers       StockTransfer[]

  @@map("branches")
}

model Department {
  id       String  @id @default(uuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code     String
  name     String
  active   Boolean @default(true)

  users User[]

  @@unique([branchId, code])
  @@map("departments")
}

// =============================================================================
// 2. NGƯỜI DÙNG, VAI TRÒ ĐỘNG, PHIÊN LÀM VIỆC
// =============================================================================

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  passwordHash       String
  name               String
  phone              String?
  title              String? // "BS.", "ĐD.", "Ths. BS"
  avatarColor        String? // màu avatar trong UI
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status             String      @default("ACTIVE") // UserStatus
  mustChangePassword Boolean     @default(false)
  /// Số lần đăng nhập sai liên tiếp; về 0 khi đăng nhập đúng (S6).
  failedLoginCount   Int         @default(0)
  /// Khoá tạm tới mốc này sau quá nhiều lần sai mật khẩu (S6).
  lockedUntil        DateTime?
  /// Lô 7 · P3: lựa chọn của người dùng trên bảng bước khách (kiểu xem, bộ lọc nhanh), JSON.
  boardPrefs         String?
  lastLoginAt        DateTime?
  resignedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  branches  UserBranch[]
  roleLinks UserRoleLink[]
  sessions  AuthSession[]
  profile   EmployeeProfile?

  assignedCustomers         Customer[]            @relation("CustomerAssignedTo")
  telesaleCustomers         Customer[]            @relation("CustomerTelesale")
  assignedLeads             Lead[]                @relation("LeadAssignedTo")
  assignedConversations     Conversation[]        @relation("ConversationAssignedTo")
  sentMessages              ChatMessage[]         @relation("ChatMessageSender")
  pancakeAgents             PancakeAgent[]        @relation("PancakeAgentUser")
  activities                Activity[]            @relation("ActivityUser")
  ownedTasks                Task[]                @relation("TaskAssignee")
  createdTasks              Task[]                @relation("TaskCreator")
  doctorAppointments        Appointment[]         @relation("AppointmentDoctor")
  createdAppointments       Appointment[]         @relation("AppointmentCreatedBy")
  consultantVisits          Visit[]               @relation("VisitConsultant")
  receptionVisits           Visit[]               @relation("VisitReceptionist")
  quotations                Quotation[]           @relation("QuotationCreatedBy")
  contracts                 Contract[]            @relation("ContractConsultant")
  payments                  Payment[]             @relation("PaymentReceivedBy")
  medicalRecords            MedicalRecord[]       @relation("MedicalRecordDoctor")
  medicalEntries            MedicalRecordEntry[]  @relation("MedicalEntryAuthor")
  procedures                ProcedureRecord[]     @relation("ProcedureSurgeon")
  photoSets                 PhotoSet[]            @relation("PhotoSetTakenBy")
  shiftAssignments          ShiftAssignment[]     @relation("ShiftAssignee")
  auditLogs                 AuditLog[]            @relation("AuditActor")
  dataAccessLogs            DataAccessLog[]       @relation("AccessActor")
  breakGlassGrants          BreakGlassGrant[]     @relation("BreakGlassUser")
  handoversFrom             CustomerHandover[]    @relation("HandoverFrom")
  handoversTo               CustomerHandover[]    @relation("HandoverTo")
  notifications             Notification[]
  consentWitnessed          ConsentForm[]         @relation("ConsentStaff")
  stockMovements            StockMovement[]       @relation("StockMovementActor")
  productUsages             ProductUsage[]        @relation("ProductUsageRecorder")
  purchaseOrders            PurchaseOrder[]       @relation("PurchaseOrderCreator")
  stockCounts               StockCount[]          @relation("StockCountCreator")
  attendances               Attendance[]          @relation("AttendanceUser")
  leaveRequests             LeaveRequest[]        @relation("LeaveUser")
  leavesApproved            LeaveRequest[]        @relation("LeaveApprover")
  commissionEntries         CommissionEntry[]     @relation("CommissionUser")
  kpiTargets                KpiTarget[]           @relation("KpiTargetUser")
  kpiActuals                KpiActual[]           @relation("KpiActualUser")
  payrollLines              PayrollLine[]         @relation("PayrollUser")
  payrollsClosed            PayrollPeriod[]       @relation("PayrollCloser")
  consultationsAsConsultant ConsultationSession[] @relation("ConsultationConsultant")
  consultationsAsDoctor     ConsultationSession[] @relation("ConsultationDoctor")
  treatmentPlans            TreatmentPlan[]       @relation("TreatmentPlanDoctor")
  caseStudiesCreated        CaseStudy[]           @relation("CaseStudyCreator")
  caseStudiesAsDoctor       CaseStudy[]           @relation("CaseStudyDoctor")
  casesMedicalApproved      CaseStudy[]           @relation("CaseMedicalApprover")
  casesMarketingApproved    CaseStudy[]           @relation("CaseMarketingApprover")
  transfersRequested        StockTransfer[]       @relation("TransferRequester")
  transfersApproved         StockTransfer[]       @relation("TransferApprover")

  @@index([status])
  @@map("users")
}

model EmployeeProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode  String?   @unique
  dob           DateTime?
  gender        String? // Gender
  idNumber      String? // CCCD — cân nhắc mã hoá khi lên production
  address       String?
  hiredAt       DateTime?
  licenseNo     String? // chứng chỉ hành nghề
  licenseExpiry DateTime?
  specialties   String? // JSON string[]
  baseSalary    Int? // đồng
  note          String?

  @@map("employee_profiles")
}

model UserBranch {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // QUAN_LY_HE_THONG, LE_TAN, TELESALE...
  name        String
  description String?
  isSystem    Boolean  @default(false) // vai trò lõi, không cho xoá
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  userLinks   UserRoleLink[]

  @@map("roles")
}

model Permission {
  id        String  @id @default(uuid())
  code      String  @unique // "customer.read", "medical.break_glass"
  module    String // "C1", "B2"...
  action    String // read | create | update | delete | approve | export...
  name      String
  isSpecial Boolean @default(false) // 4 quyền đặc biệt tách khỏi CRUD

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        String     @default("BRANCH") // PermissionScope: ALL | BRANCH | OWN

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleLink {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_links")
}

// Phiên làm việc THU HỒI ĐƯỢC. Access token sống 15 phút; refresh token
// lưu ở đây dạng hash, xoay vòng mỗi lần refresh và phát hiện tái sử dụng.
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  replacedById     String? // chuỗi xoay vòng — phát hiện tái dùng token cũ
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

// =============================================================================
// 3. KIỂM TOÁN — GHI THAY ĐỔI VÀ GHI HÀNH VI ĐỌC
// =============================================================================

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String? // giữ lại tên kể cả khi user bị xoá
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  action    String // AuditAction
  entity    String // "Customer", "Contract"...
  entityId  String?
  summary   String
  changes   String? // JSON { field: [before, after] }
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Ghi cả hành vi CHỈ ĐỌC với bệnh án / ảnh / SĐT — bắt buộc theo mục 6.6.
model DataAccessLog {
  id           String    @id @default(uuid())
  actorId      String?
  actor        User?     @relation("AccessActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName    String?
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  resourceType String // AccessResourceType
  resourceId   String?
  severity     String    @default("NORMAL") // AccessSeverity
  reason       String? // bắt buộc khi break-glass
  rowCount     Int? // với export
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([actorId, createdAt])
  @@index([severity, createdAt])
  @@map("data_access_logs")
}

// Cấp quyền xem bệnh án ngoài phạm vi trong 30 phút, có lý do.
model BreakGlassGrant {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("BreakGlassUser", fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId   String?
  reason     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, customerId, expiresAt])
  @@map("break_glass_grants")
}

// Bàn giao khách khi nhân viên nghỉ việc / đổi người phụ trách.
model CustomerHandover {
  id            String   @id @default(uuid())
  fromUserId    String?
  fromUser      User?    @relation("HandoverFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUserId      String
  toUser        User     @relation("HandoverTo", fields: [toUserId], references: [id], onDelete: Restrict)
  reason        String
  customerCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("customer_handovers")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  level     String    @default("INFO") // INFO | WARN | DANGER
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// =============================================================================
// 4. MARKETING — KÊNH, CHIẾN DỊCH, LEAD
// =============================================================================

model Channel {
  id     String  @id @default(uuid())
  key    String  @unique // "facebook", "tiktok"
  name   String
  kind   String // ChannelKind
  active Boolean @default(true)

  campaigns    Campaign[]
  leads        Lead[]
  customers    Customer[]
  pancakePages PancakePage[]

  @@map("channels")
}

model Campaign {
  id          String    @id @default(uuid())
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  channelId   String?
  channel     Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  code        String    @unique
  name        String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  budget      Int? // đồng
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  costs     CampaignCost[]
  leads     Lead[]
  customers Customer[]

  @@map("campaigns")
}

model CampaignCost {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Int // đồng
  note       String?
  /// F15: nguồn nhập chi phí (CostSource): MANUAL | CSV_META | CSV_TIKTOK | CSV_OTHER.
  source     String   @default("MANUAL")
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([campaignId, date])
  @@map("campaign_costs")
}

model Lead {
  id                  String    @id @default(uuid())
  branchId            String?
  branch              Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  channelId           String?
  channel             Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaignId          String?
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name                String
  phone               String?
  /// SĐT chuẩn hoá dạng 0xxxxxxxxx (lib/phone.ts), dùng chống trùng (B17).
  phoneNormalized     String?
  zaloUserId          String?
  interest            String? // dịch vụ quan tâm
  stage               String    @default("NEW") // LeadStage
  lostReason          String?
  note                String?
  assignedToId        String?
  assignedTo          User?     @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedCustomerId String?   @unique
  convertedCustomer   Customer? @relation("LeadConverted", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  externalId          String? // id từ Facebook Lead Ads — dùng để chống trùng
  /// F5: nguồn quảng cáo lấy từ Pancake (nếu API trả về).
  adId                String?
  adPostId            String?
  adCampaign          String?
  firstContactAt      DateTime?
  /// F15: mốc lead có SĐT (lần đầu), mốc khách đến lần đầu (check-in).
  hasPhoneAt          DateTime?
  showedUpAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([externalId])
  @@index([hasPhoneAt])
  @@index([showedUpAt])
  @@index([stage, createdAt])
  @@index([assignedToId])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([branchId])
  @@map("leads")
}

// =============================================================================
// 5. KHÁCH HÀNG — LIÊN THÔNG TOÀN CÔNG TY
// =============================================================================

model Customer {
  id                String    @id @default(uuid())
  code              String    @unique // KH-2608-0187
  name              String
  /// Tên bỏ dấu, chữ thường, gộp khoảng trắng — để cảnh báo tên gần giống (B17).
  nameNormalized    String?
  phone             String?
  /// SĐT chuẩn hoá dạng 0xxxxxxxxx (lib/phone.ts), dùng chống trùng (B17).
  phoneNormalized   String?
  email             String?
  zaloUserId        String?   @unique
  dob               DateTime?
  gender            String? // Gender
  address           String?
  city              String?
  status            String    @default("LEAD") // CustomerStatus
  stage             String    @default("TIEP_CAN") // giai đoạn phễu, xem lib/stages.ts (INJECTION | SURGERY)
  /// F1: lý do mất khách (LostReason), bắt buộc khi ở bước mất khách.
  lostReason        String?
  stageChangedAt    DateTime?
  /// F1: lần làm dịch vụ gần nhất, để nhận ra khách quay lại trong N ngày.
  lastServiceAt     DateTime?
  /// Nghị định 13/2023: khách đồng ý cho xử lý dữ liệu bằng AI (có chuyển ra nước ngoài).
  aiDataConsent     Boolean   @default(false)
  aiDataConsentAt   DateTime?
  aiDataConsentById String?
  /// F11: khách từ chối nhận tin gửi theo nhóm (không bao giờ nằm trong hàng đợi gửi).
  optOut            Boolean   @default(false)
  optOutAt          DateTime?
  optOutReason      String?
  channelId         String?
  channel           Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  interest          String? // JSON string[] — dịch vụ quan tâm
  budgetNote        String?
  note              String?
  assignedToId      String? // tư vấn viên
  assignedTo        User?     @relation("CustomerAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  telesaleId        String?
  telesale          User?     @relation("CustomerTelesale", fields: [telesaleId], references: [id], onDelete: SetNull)
  hidden            Boolean   @default(false) // "ẩn hồ sơ" thay cho xoá
  hiddenReason      String?
  /// Hồ sơ này đã được gộp vào khách nào (màn Gộp hồ sơ trùng, B17).
  mergedIntoId      String?
  lastContactAt     DateTime?
  /// F32: lần trả tiền thật đầu tiên (không tính hoàn tiền, voucher).
  firstPurchaseAt   DateTime?
  /// F19: mã giới thiệu của khách này; khách giới thiệu mình (Customer.id).
  referralCode      String?   @unique
  referredById      String?
  referredAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  branchLinks          CustomerBranchLink[]
  tags                 CustomerTag[]
  activities           Activity[]
  tasks                Task[]
  conversations        Conversation[]
  appointments         Appointment[]
  visits               Visit[]
  quotations           Quotation[]
  contracts            Contract[]
  invoices             Invoice[]
  payments             Payment[]
  medicalRecords       MedicalRecord[]
  consentForms         ConsentForm[]
  photoSets            PhotoSet[]
  procedures           ProcedureRecord[]
  dataAccessLogs       DataAccessLog[]
  breakGlass           BreakGlassGrant[]
  leadOrigin           Lead?                 @relation("LeadConverted")
  stageHistory         StageHistory[]
  productUsages        ProductUsage[]
  consultationSessions ConsultationSession[]
  treatmentPlans       TreatmentPlan[]
  caseStudies          CaseStudy[]
  upsellOffers         UpsellOffer[]
  /// Lô 8 · P6: cơ hội bán (pipeline theo cơ hội); V3: gói liệu trình.
  opportunities        Opportunity[]
  treatmentPackages    TreatmentPackage[]
  /// Lô 8 · C3: hồ sơ nhu cầu chọn nhanh (JSON: vùng, ngân sách, nỗi sợ, người quyết định, dịp, nơi so sánh).
  needsProfile         String?

  @@index([status])
  @@index([stage])
  @@index([assignedToId])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([nameNormalized])
  @@index([createdAt])
  @@index([lastContactAt])
  @@index([firstPurchaseAt])
  @@index([referredById])
  @@map("customers")
}

// F1: lịch sử đổi bước của khách, nền cho báo cáo chuyển đổi theo bước.
model StageHistory {
  id            String       @id @default(uuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromStage     String?
  toStage       String
  /// MANUAL | AUTO | IMPORT | MIGRATION
  source        String       @default("MANUAL")
  /// Sự kiện gây ra khi source = AUTO (StageEvent)
  event         String?
  lostReason    String?
  note          String?
  userId        String?
  userName      String?
  createdAt     DateTime     @default(now())
  /// Lô 8 · P6: cơ hội của lần đổi bước (null = dòng cũ chưa chuyển dữ liệu).
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([toStage, createdAt])
  @@index([opportunityId, createdAt])
  @@map("stage_history")
}

// Khách liên thông toàn công ty nhưng có ghi nhận từng cơ sở đã phục vụ.
model CustomerBranchLink {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isPrimary   Boolean  @default(false)
  firstSeenAt DateTime @default(now())

  @@unique([customerId, branchId])
  @@index([branchId])
  @@map("customer_branch_links")
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String @default("#177f4d")

  customers     CustomerTag[]
  conversations ConversationTag[]

  @@map("tags")
}

model CustomerTag {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@map("customer_tags")
}

model Activity {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  type       String // ActivityType
  content    String
  meta       String? // JSON
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("activities")
}

model Task {
  id              String    @id @default(uuid())
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          String    @default("OPEN") // TaskStatus
  priority        String    @default("NORMAL") // TaskPriority
  dueAt           DateTime?
  completedAt     DateTime?
  assigneeId      String?
  assignee        User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  /// Lô 4: loại việc (TaskKind) để trang Việc của tôi, màn Chăm sóc gom nhóm.
  kind            String    @default("OTHER")
  /// Quy tắc tự động sinh ra việc này (khoá job, F9); trống = người tạo tay.
  source          String?
  /// F10: lần thực hiện và mốc chăm sóc (D0, D1, D3...).
  procedureId     String?
  milestone       String?
  /// F10: kết quả "Đã liên hệ" (AftercareResult) và ghi chú.
  result          String?
  resultNote      String?
  contactedAt     DateTime?
  contactedById   String?
  /// Lô 8 · J3: việc sinh từ checklist bước (cơ hội, bước, mục checklist).
  opportunityId   String?
  stageKey        String?
  checklistItemId String?

  @@index([assigneeId, status])
  @@index([opportunityId])
  @@index([dueAt])
  @@index([kind, status, dueAt])
  @@index([customerId])
  @@index([procedureId])
  @@map("tasks")
}

// =============================================================================
// 6. HỘP THƯ ZALO — MÀN HÌNH LÕI
// =============================================================================

model ZaloOAConfig {
  id               String    @id @default(uuid())
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  label            String    @default("OA chính")
  oaId             String
  appId            String
  appSecretEnc     String // mã hoá AES-256-GCM, xem src/lib/crypto.ts
  accessTokenEnc   String?
  refreshTokenEnc  String?
  webhookSecretEnc String?
  tokenExpiresAt   DateTime?
  active           Boolean   @default(true)
  updatedAt        DateTime  @updatedAt

  conversations Conversation[]

  @@map("zalo_oa_configs")
}

model Conversation {
  id                 String        @id @default(uuid())
  branchId           String?
  branch             Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  oaConfigId         String?
  oaConfig           ZaloOAConfig? @relation(fields: [oaConfigId], references: [id], onDelete: SetNull)
  kind               String        @default("CUSTOMER") // ConversationKind: CUSTOMER | GROUP
  channel            String        @default("ZALO_OA") // ConversationChannel
  title              String
  externalId         String? // zalo user id / group id
  memberCount        Int?
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId       String?
  assignedTo         User?         @relation("ConversationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  unreadCount        Int           @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  messages              ChatMessage[]
  pancakePageId         String?
  pancakePage           PancakePage?  @relation(fields: [pancakePageId], references: [id], onDelete: SetNull)
  /// ID hội thoại bên Pancake — khoá khử trùng lặp khi đồng bộ lại.
  pancakeConversationId String?       @unique
  /// F5: nguồn quảng cáo của hội thoại (Pancake trả về nếu khách nhắn từ quảng cáo).
  adId                  String?
  adPostId              String?
  adCampaign            String?
  leadId                String?
  /// F26: mốc tin khách gửi, tin mình trả lời gần nhất; khách chờ từ lúc nào
  /// (tin khách đầu tiên chưa được trả lời, null = không ai chờ).
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  waitingSince          DateTime?
  assignedAt            DateTime?
  /// F9 quy tắc 2: tin có từ khoá y khoa, đã báo bác sĩ.
  medicalFlag           Boolean       @default(false)
  medicalFlagAt         DateTime?

  tags  ConversationTag[]
  notes ConversationNote[]

  @@unique([externalId, oaConfigId])
  @@index([kind, lastMessageAt])
  @@index([assignedToId])
  @@index([branchId])
  @@index([customerId])
  @@index([channel])
  @@index([waitingSince])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // MessageDirection: IN | OUT
  type           String       @default("TEXT") // MessageType
  content        String
  senderUserId   String?
  senderUser     User?        @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderName     String?
  status         String       @default("SENT") // MessageStatus
  externalId     String?      @unique // zalo message id — chống ghi trùng webhook
  errorMessage   String?
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("chat_messages")
}

model MessageAttachment {
  id              String      @id @default(uuid())
  messageId       String
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind            String // IMAGE | FILE
  fileName        String
  mimeType        String?
  size            Int?
  /// Khoá trong kho tệp mã hoá (lib/storage.ts). Trống khi tệp chỉ nằm ở máy chủ kênh chat (xem url).
  storageKey      String?
  /// IV và auth tag AES-GCM khi tệp nằm trong kho mã hoá của mình.
  encIv           String?
  encTag          String?
  /// Đường dẫn gốc bên Zalo/Pancake khi chưa tải về kho (B13).
  url             String?
  /// Bộ ảnh hồ sơ khách đã lưu từ tệp này ("Lưu ảnh vào hồ sơ", B13).
  savedPhotoSetId String?
  createdAt       DateTime    @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model QuickReply {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("quick_replies")
}

// Bảo đảm webhook Zalo xử lý ĐÚNG MỘT LẦN (idempotent).
model ZaloWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  eventName   String
  payload     String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@map("zalo_webhook_events")
}

// =============================================================================
// 7. LỄ TÂN — PHÒNG, LỊCH HẸN, CHECK-IN
// =============================================================================

model Room {
  id       String  @id @default(uuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code     String
  name     String
  type     String  @default("CONSULT") // RoomType: CONSULT | OPERATING | MINOR_OP | TREATMENT | RECOVERY
  capacity Int     @default(1)
  active   Boolean @default(true)

  appointments Appointment[]
  procedures   ProcedureRecord[]

  @@unique([branchId, code])
  @@map("rooms")
}

model Appointment {
  id                   String    @id @default(uuid())
  branchId             String
  branch               Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type                 String    @default("CONSULT") // AppointmentType
  title                String
  serviceId            String?
  service              Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorId             String?
  doctor               User?     @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  roomId               String?
  room                 Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startAt              DateTime
  endAt                DateTime
  status               String    @default("PENDING") // AppointmentStatus
  /// F25: mã lịch (LH-YYMM-NNNN), dùng làm nội dung chuyển khoản cọc.
  code                 String?   @unique
  depositAmount        Int       @default(0) // đồng
  /// DepositStatus: CHO_COC | DA_COC | HOAN_COC; null = không yêu cầu cọc
  depositStatus        String?
  depositConfirmedAt   DateTime?
  depositConfirmedById String?
  note                 String?
  cancelReason         String?
  createdById          String?
  createdBy            User?     @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  reminders AppointmentReminder[]
  visit     Visit?
  payments  Payment[]

  @@index([branchId, startAt])
  @@index([customerId])
  @@index([status])
  @@index([depositStatus])
  @@map("appointments")
}

model AppointmentReminder {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       String      @default("ZALO_ZNS") // NotificationChannel
  scheduledAt   DateTime
  sentAt        DateTime?
  status        String      @default("PENDING")
  error         String?

  @@index([status, scheduledAt])
  @@map("appointment_reminders")
}

// CHECK-IN: khách đã đến — hàng đợi thời gian thực của lễ tân.
model Visit {
  id             String       @id @default(uuid())
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  queueNumber    Int
  status         String       @default("WAITING") // VisitStatus
  consultantId   String?
  consultant     User?        @relation("VisitConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  /// Lễ tân đã tiếp đón. Không có trường này thì không quy được năng suất
  /// tiếp đón về từng người — bảng hiệu suất lễ tân chỉ ra số tổng.
  receptionistId String?
  receptionist   User?        @relation("VisitReceptionist", fields: [receptionistId], references: [id], onDelete: SetNull)
  purpose        String?
  note           String?
  checkedInAt    DateTime     @default(now())
  calledAt       DateTime?
  finishedAt     DateTime?

  @@index([branchId, status])
  @@index([checkedInAt])
  @@map("visits")
}

// =============================================================================
// 8. PHÂN LỊCH LÀM VIỆC
// =============================================================================

model ShiftTemplate {
  id        String  @id @default(uuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code      String
  name      String
  kind      String  @default("FULL_DAY") // ShiftKind
  startTime String // "07:30"
  endTime   String // "16:30"
  color     String  @default("#177f4d")
  active    Boolean @default(true)

  assignments ShiftAssignment[]

  @@unique([branchId, code])
  @@map("shift_templates")
}

model ShiftAssignment {
  id          String         @id @default(uuid())
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation("ShiftAssignee", fields: [userId], references: [id], onDelete: Cascade)
  templateId  String?
  template    ShiftTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date        DateTime
  status      String         @default("PLANNED") // ShiftAssignmentStatus
  note        String?
  attendances Attendance[]

  @@unique([userId, date, templateId])
  @@index([branchId, date])
  @@map("shift_assignments")
}

// =============================================================================
// 9. DỊCH VỤ, BÁO GIÁ, HỢP ĐỒNG, TIỀN
// =============================================================================

model ServiceCategory {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  services Service[]

  @@map("service_categories")
}

model Service {
  id               String           @id @default(uuid())
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  code             String           @unique
  name             String
  kind             String           @default("SURGERY") // ServiceKind
  description      String?
  durationMin      Int              @default(60)
  recoveryDays     Int? // thời gian nghỉ dưỡng
  requiresConsent  Boolean          @default(true)
  requiresPreOpLab Boolean          @default(false)
  anesthesia       String? // AnesthesiaType mặc định
  /// F10: số ngày tái tiêm (botox 120, filler 180...). Trống = không nhắc tái tiêm.
  retreatDays      Int?
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())

  prices             ServicePrice[]
  promotions         PromotionService[]
  appointments       Appointment[]
  quotationItems     QuotationItem[]
  contractItems      ContractItem[]
  procedures         ProcedureRecord[]
  commissionRules    CommissionRule[]
  treatmentPlanItems TreatmentPlanItem[]
  caseStudies        CaseStudy[]
  materials          ServiceMaterial[]
  upsellTriggers     UpsellRule[]        @relation("UpsellTrigger")
  upsellSuggests     UpsellRule[]        @relation("UpsellSuggest")

  @@map("services")
}

// Giá theo CƠ SỞ và theo hiệu lực thời gian.
model ServicePrice {
  id        String    @id @default(uuid())
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  price     Int // đồng
  minPrice  Int? // sàn được phép giảm
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())

  @@index([serviceId, branchId, validFrom])
  @@map("service_prices")
}

model Quotation {
  id                  String    @id @default(uuid())
  branchId            String
  branch              Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  code                String    @unique // BG-2608-0143
  status              String    @default("DRAFT") // QuotationStatus
  subtotal            Int       @default(0)
  discount            Int       @default(0)
  total               Int       @default(0)
  note                String?
  validUntil          DateTime?
  createdById         String?
  createdBy           User?     @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentAt              DateTime?
  decidedAt           DateTime?
  /// F21: giảm vượt trần của người lập thì chờ quản lý duyệt (ApprovalStatus).
  approvalStatus      String    @default("NOT_REQUIRED")
  approvalRequestedAt DateTime?
  approvedById        String?
  approvedAt          DateTime?
  approvalNote        String?
  /// Lô 7 · V1: phương án được chọn khi lập từ báo giá 3 phương án (BASIC | RECOMMENDED | PACKAGE).
  optionTier          String?
  /// Lô 8 · P6: cơ hội của báo giá; V6: lý do khách từ chối, việc chăm lại đã tạo.
  opportunityId       String?
  rejectReason        String?
  followupTaskId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  treatmentPlan TreatmentPlan?
  items         QuotationItem[]
  contract      Contract?

  @@index([approvalStatus])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id                String    @id @default(uuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name              String
  quantity          Int       @default(1)
  unitPrice         Int
  discount          Int       @default(0)
  amount            Int
  /// F13 + F21: giá niêm yết lúc lập, tổng tiền giảm so với niêm yết, phần
  /// giảm thuộc đợt ưu đãi, lý do, đợt ưu đãi, người duyệt giảm vượt trần.
  listPrice         Int?
  discountAmount    Int       @default(0)
  promotionDiscount Int       @default(0)
  discountReason    String?
  promotionId       String?
  approvedById      String?

  @@map("quotation_items")
}

model Contract {
  id              String     @id @default(uuid())
  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotationId     String?    @unique
  quotation       Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  code            String     @unique // DH-2608-0142
  status          String     @default("DRAFT") // ContractStatus
  subtotal        Int        @default(0)
  discount        Int        @default(0)
  total           Int        @default(0)
  paidAmount      Int        @default(0)
  consultantId    String?
  consultant      User?      @relation("ContractConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  signedAt        DateTime?
  cancelReason    String?
  note            String?
  /// F17: CloseType FULL = sale chốt từ A đến Z, PARTIAL = sale kéo đến, bác sĩ chốt.
  closeType       String     @default("FULL")
  closingDoctorId String?
  /// Lô 8 · P6: cơ hội của hợp đồng.
  opportunityId   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  items             ContractItem[]
  invoices          Invoice[]
  payments          Payment[]
  procedures        ProcedureRecord[]
  commissionEntries CommissionEntry[]

  @@index([customerId])
  @@index([branchId, signedAt])
  @@map("contracts")
}

model ContractItem {
  id                String   @id @default(uuid())
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name              String
  quantity          Int      @default(1)
  unitPrice         Int
  discount          Int      @default(0)
  amount            Int
  deliveredQty      Int      @default(0)
  /// F13 + F21: giá niêm yết lúc lập, tổng tiền giảm so với niêm yết, phần
  /// giảm thuộc đợt ưu đãi, lý do, đợt ưu đãi, người duyệt giảm vượt trần.
  listPrice         Int?
  discountAmount    Int      @default(0)
  promotionDiscount Int      @default(0)
  discountReason    String?
  promotionId       String?
  approvedById      String?
  /// F17: dòng upsale do kỹ thuật viên (điều dưỡng, bác sĩ) bán thêm, hưởng % upsale.
  upsellById        String?

  @@index([promotionId])
  @@index([upsellById])
  @@map("contract_items")
}

model Invoice {
  id         String    @id @default(uuid())
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  code       String    @unique // HD-2608-0071
  status     String    @default("DRAFT") // InvoiceStatus
  title      String? // "Cọc 30% (khi ký)"
  amount     Int
  paidAmount Int       @default(0)
  dueDate    DateTime?
  issuedAt   DateTime?
  voidReason String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id                String            @id @default(uuid())
  branchId          String
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId        String?
  contract          Contract?         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  invoiceId         String?
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// F25: phiếu cọc gắn với lịch hẹn.
  appointmentId     String?
  appointment       Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  /// PaymentType: DEPOSIT | PAYMENT | REFUND (REFUND lưu số âm)
  type              String            @default("PAYMENT")
  misaInvoiceNo     String?
  /// Phiếu cọc đã được trừ vào lần thanh toán dịch vụ lúc nào.
  depositAppliedAt  DateTime?
  code              String            @unique // PT-2608-0091
  amount            Int
  method            String            @default("CASH") // PaymentMethod
  reference         String? // mã giao dịch ngân hàng
  note              String?
  receivedById      String?
  receivedBy        User?             @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  paidAt            DateTime          @default(now())
  createdAt         DateTime          @default(now())
  commissionEntries CommissionEntry[]

  @@index([branchId, paidAt])
  @@index([customerId])
  @@index([appointmentId])
  @@map("payments")
}

// =============================================================================
// 10. Y KHOA — CÁCH LY THEO CƠ SỞ
// =============================================================================

model MedicalRecord {
  id                String   @id @default(uuid())
  branchId          String // NOT NULL — cách ly theo cơ sở
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  code              String   @unique // BA-2608-0044
  bloodType         String?
  chronicDisease    String?
  currentMedication String?
  smoking           Boolean  @default(false)
  pregnancyNote     String?
  pastAesthetic     String? // tiền sử PTTM
  doctorId          String?
  doctor            User?    @relation("MedicalRecordDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entries           MedicalRecordEntry[]
  allergies         Allergy[]
  contraindications Contraindication[]
  procedures        ProcedureRecord[]

  @@unique([customerId, branchId])
  @@index([branchId])
  @@map("medical_records")
}

model MedicalRecordEntry {
  id         String        @id @default(uuid())
  recordId   String
  record     MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  kind       String        @default("EXAM") // EXAM | DIAGNOSIS | NOTE | PLAN
  content    String
  authorId   String?
  author     User?         @relation("MedicalEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  createdAt  DateTime      @default(now())

  @@index([recordId, createdAt])
  @@map("medical_record_entries")
}

model Allergy {
  id        String        @id @default(uuid())
  recordId  String
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  substance String
  reaction  String?
  severity  String        @default("NORMAL")
  note      String?

  @@map("allergies")
}

model Contraindication {
  id       String        @id @default(uuid())
  recordId String
  record   MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  content  String
  blocking Boolean       @default(false) // chặn xác nhận ca mổ
  note     String?

  @@map("contraindications")
}

model ConsentForm {
  id           String           @id @default(uuid())
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  procedureId  String?
  procedure    ProcedureRecord? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  type         String           @default("SURGERY") // ConsentType
  title        String
  bodyText     String
  status       String           @default("DRAFT") // ConsentStatus
  signedAt     DateTime?
  signatureKey String? // ảnh chữ ký trong kho tệp (đã mã hoá)
  staffId      String?
  staff        User?            @relation("ConsentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([customerId])
  @@index([branchId])
  @@map("consent_forms")
}

model PhotoSet {
  id                  String           @id @default(uuid())
  branchId            String
  branch              Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId          String
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  procedureId         String?
  procedure           ProcedureRecord? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  stage               String // PhotoStage: PRE_OP | D0 | D1 | D7 | D30 | M1 | M3 | M6 | CHAT | CONSULT
  /// F2: cho phép dùng ảnh làm marketing. Mặc định KHÔNG; chỉ bác sĩ, quản lý bật (có audit).
  consentForMarketing Boolean          @default(false)
  consentSetById      String?
  consentSetAt        DateTime?
  /// F2: ảnh tự lưu từ tin nhắn chat thì nhớ tin gốc.
  sourceMessageId     String?
  takenAt             DateTime         @default(now())
  takenById           String?
  takenBy             User?            @relation("PhotoSetTakenBy", fields: [takenById], references: [id], onDelete: SetNull)
  note                String?

  photos PhotoAsset[]

  @@index([customerId, stage])
  @@index([branchId])
  @@map("photo_sets")
}

// Tệp ảnh KHÔNG nằm trong DB. storageKey trỏ tới tệp đã mã hoá AES-256-GCM
// trong kho tệp; chỉ phát URL ký hạn ngắn và luôn ghi DataAccessLog.
model PhotoAsset {
  id         String   @id @default(uuid())
  photoSetId String
  photoSet   PhotoSet @relation(fields: [photoSetId], references: [id], onDelete: Cascade)
  storageKey String
  fileName   String
  mimeType   String   @default("image/jpeg")
  size       Int      @default(0)
  angle      String? // "front" | "left45" | "profile"
  encIv      String // IV của AES-GCM
  encTag     String // auth tag
  createdAt  DateTime @default(now())

  @@map("photo_assets")
}

// Phiếu phẫu thuật / thủ thuật + lịch phòng mổ (mức Giai đoạn 1).
model ProcedureRecord {
  id                   String         @id @default(uuid())
  branchId             String
  branch               Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId           String
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordId             String?
  record               MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  contractId           String?
  contract             Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  serviceId            String?
  service              Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  code                 String         @unique // PM-2608-0033
  title                String
  roomId               String?
  room                 Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  surgeonId            String?
  surgeon              User?          @relation("ProcedureSurgeon", fields: [surgeonId], references: [id], onDelete: SetNull)
  teamNote             String? // ê-kíp dạng văn bản (Giai đoạn 2 tách bảng riêng)
  materialNote         String? // vật tư dự trù (Giai đoạn 2 nối kho theo lô)
  anesthesia           String         @default("LOCAL") // AnesthesiaType
  status               String         @default("SCHEDULED") // ProcedureStatus
  scheduledAt          DateTime
  durationMin          Int            @default(60)
  startedAt            DateTime?
  finishedAt           DateTime?
  report               String? // tường trình
  checklist            String? // JSON boolean[7] theo CHECKLIST tiền phẫu
  /// F14: vùng tiêm, lượng tiêm theo đơn vị 0,1cc (15 = 1,5cc), điều dưỡng phụ.
  injectionArea        String?
  volumeTenthCc        Int?
  nurseId              String?
  /// F10: số ngày tái tiêm riêng của lần này (bác sĩ chỉnh), mốc tái tiêm, đã sinh việc chăm sóc.
  retreatDays          Int?
  retreatDueAt         DateTime?
  aftercareGeneratedAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  consentForms  ConsentForm[]
  photoSets     PhotoSet[]
  productUsages ProductUsage[]
  caseStudies   CaseStudy[]

  @@index([branchId, scheduledAt])
  @@index([customerId])
  @@index([retreatDueAt])
  @@map("procedure_records")
}

// =============================================================================
// KHO VẬT TƯ THEO LÔ  (Giai đoạn 2, mục 3.3 nhóm E1)
// =============================================================================
//
// Điểm sống còn của phân hệ này KHÔNG phải là biết còn bao nhiêu hàng, mà là
// TRUY VẾT: khi nhà sản xuất thu hồi một lô túi ngực hay filler, phòng khám
// phải trả lời trong vài phút "lô đó đã dùng cho những khách nào".
//
// Vì vậy mọi lần xuất dùng cho khách đều ghi ProductUsage gắn CHẶT vào StockLot
// và Customer — không cộng trừ số lượng suông.

model Warehouse {
  id        String      @id @default(uuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code      String
  name      String
  /// MAIN = kho tổng (nhập hàng từ nhà cung cấp), SUB = kho con của khoa/phòng
  /// (nhận hàng từ kho tổng qua phiếu chuyển kho).
  kind      String      @default("MAIN")
  /// Kho tổng của kho con này. Null với kho tổng.
  parentId  String?
  parent    Warehouse?  @relation("WarehouseTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Warehouse[] @relation("WarehouseTree")
  isDefault Boolean     @default(false)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  lots         StockLot[]
  movements    StockMovement[]
  counts       StockCount[]
  transfersOut StockTransfer[] @relation("TransferFrom")
  transfersIn  StockTransfer[] @relation("TransferTo")

  @@unique([branchId, code])
  @@map("warehouses")
}

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  taxCode     String?
  phone       String?
  email       String?
  address     String?
  contactName String?
  note        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots           StockLot[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  kind        String   @default("CONSUMABLE") // ProductKind
  unit        String   @default("cái")
  /// Vật tư cấy ghép (túi ngực, sụn nhân tạo) BẮT BUỘC theo lô và bắt buộc ghi
  /// mã lô vào hồ sơ khách — đây là yêu cầu truy vết, không phải tuỳ chọn.
  isImplant   Boolean  @default(false)
  requiresLot Boolean  @default(true)
  /// Định mức tối thiểu — dưới mức này cảnh báo để bổ sung kịp thời.
  minStock    Int      @default(0)
  /// Định mức tối đa — vượt mức này cảnh báo ứ đọng vốn và rủi ro hết hạn.
  maxStock    Int      @default(0)
  note        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots             StockLot[]
  movements        StockMovement[]
  usages           ProductUsage[]
  poItems          PurchaseOrderItem[]
  countItems       StockCountItem[]
  serviceMaterials ServiceMaterial[]
  transferItems    StockTransferItem[]

  @@map("products")
}

model StockLot {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  lotNumber    String // mã lô của nhà sản xuất
  serialNumber String? // số seri riêng từng cái (túi ngực có)
  expiryDate   DateTime?
  /// Số lượng còn lại của LÔ này. Không bao giờ sửa tay — chỉ đổi qua
  /// StockMovement để luôn đối chiếu được với sổ.
  quantity     Int       @default(0)
  unitCost     Int       @default(0) // đồng
  receivedAt   DateTime  @default(now())
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movements     StockMovement[]
  usages        ProductUsage[]
  transferItems StockTransferItem[]

  @@unique([productId, warehouseId, lotNumber])
  @@index([expiryDate])
  @@map("stock_lots")
}

model StockMovement {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotId       String?
  lot         StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  type        String // StockMoveType: IN | OUT | TRANSFER | ADJUST | DISPOSE
  /// Dương là nhập, âm là xuất. Cộng dồn cột này phải khớp StockLot.quantity.
  quantity    Int
  reason      String?
  referenceId String? // procedureId / purchaseOrderId / stockCountId
  actorId     String?
  actor       User?    @relation("StockMovementActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([warehouseId, createdAt])
  @@index([productId])
  @@map("stock_movements")
}

model ProductUsage {
  id          String           @id @default(uuid())
  productId   String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotId       String?
  lot         StockLot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)
  /// Gắn vào KHÁCH và CA MỔ — đây là mắt xích cho phép truy vết ngược từ lô ra khách.
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  procedureId String?
  procedure   ProcedureRecord? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)

  /// Số ĐƠN VỊ NGUYÊN trừ khỏi lô (mở ống nào tính ống đó).
  quantity       Int      @default(1)
  /// F14: lượng dùng thật theo 0,1 đơn vị (5 = 0,5 ống). Trống ở dữ liệu cũ = quantity × 10.
  quantityTenths Int?
  /// F14: giá vốn của lượng dùng thật tại thời điểm dùng (đồng) = đơn giá lô × lượng.
  costAtUse      Int?
  usedAt         DateTime @default(now())
  recordedById   String?
  recordedBy     User?    @relation("ProductUsageRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime @default(now())

  @@index([lotId])
  @@index([customerId])
  @@map("product_usages")
}

model PurchaseOrder {
  id          String    @id @default(uuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  code        String    @unique
  status      String    @default("DRAFT") // PurchaseOrderStatus
  total       Int       @default(0)
  orderedAt   DateTime  @default(now())
  receivedAt  DateTime?
  note        String?
  createdById String?
  createdBy   User?     @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotNumber  String?
  expiryDate DateTime?
  quantity   Int
  unitCost   Int           @default(0)
  amount     Int           @default(0)

  @@map("purchase_order_items")
}

model StockCount {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  code        String    @unique
  status      String    @default("DRAFT") // DRAFT | FINALIZED
  countedAt   DateTime  @default(now())
  finalizedAt DateTime?
  note        String?
  createdById String?
  createdBy   User?     @relation("StockCountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  items StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id           String     @id @default(uuid())
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  lotId        String?
  systemQty    Int        @default(0) // sổ sách
  countedQty   Int        @default(0) // đếm thực tế
  note         String?

  @@map("stock_count_items")
}

// =============================================================================
// NHÂN SỰ: CHẤM CÔNG · HOA HỒNG · KPI   (Giai đoạn 2, mục 3.3 nhóm E2/A4)
// =============================================================================

model Attendance {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Ca đã xếp để đối chiếu đi muộn / về sớm. Null = chấm công ngoài ca.
  shiftId  String?
  shift    ShiftAssignment? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  date          DateTime
  checkInAt     DateTime?
  checkOutAt    DateTime?
  status        String    @default("PRESENT") // AttendanceStatus
  lateMinutes   Int       @default(0)
  earlyMinutes  Int       @default(0)
  workedMinutes Int       @default(0)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, date])
  @@index([branchId, date])
  @@map("attendances")
}

model LeaveRequest {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  type         String    @default("ANNUAL") // LeaveType
  fromDate     DateTime
  toDate       DateTime
  days         Int       @default(1)
  reason       String
  status       String    @default("PENDING") // LeaveStatus
  approverId   String?
  approver     User?     @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, fromDate])
  @@map("leave_requests")
}

model CommissionRule {
  id        String   @id @default(uuid())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  /// Vai trò được hưởng: TU_VAN_VIEN | TELESALE | BAC_SI …
  roleCode  String
  /// COLLECTED = tính trên TIỀN THỰC THU (mặc định, đúng nguyên tắc trong tài
  /// liệu), SIGNED = tính trên doanh số ký — chỉ mở khi chủ đầu tư chấp nhận
  /// rủi ro trả hoa hồng cho hợp đồng chưa thu được tiền.
  basis     String   @default("COLLECTED") // CommissionBasis
  percent   Int      @default(0) // phần nghìn (‰) để tránh số thực: 35 = 3,5%
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  minAmount Int      @default(0)
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CommissionEntry[]

  @@map("commission_rules")
}

model CommissionEntry {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation("CommissionUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ruleId     String?
  rule       CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Nguồn phát sinh: phiếu thu nào sinh ra khoản hoa hồng này.
  paymentId  String?
  payment    Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  contractId String?
  contract   Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)

  periodKey  String // "2026-08" — khoá kỳ để chốt
  baseAmount Int      @default(0) // tiền thực thu làm căn cứ
  percent    Int      @default(0) // ‰
  amount     Int      @default(0) // tiền hoa hồng
  status     String   @default("PENDING") // CommissionStatus
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, periodKey])
  @@index([branchId, periodKey])
  @@map("commission_entries")
}

model KpiDefinition {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  /// SALES | NURSING | DOCTOR | RECEPTION — KPI điều dưỡng CỐ Ý tách khỏi
  /// nhóm SALES để không gắn tiền vào tay người chỉ định chuyên môn.
  group          String   @default("SALES") // KpiGroup
  unit           String   @default("số")
  higherIsBetter Boolean  @default(true)
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  targets KpiTarget[]
  actuals KpiActual[]

  @@map("kpi_definitions")
}

model KpiTarget {
  id           String        @id @default(uuid())
  definitionId String
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?         @relation("KpiTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  periodKey    String // "2026-08"
  targetValue  Int           @default(0)
  createdAt    DateTime      @default(now())

  @@unique([definitionId, userId, periodKey])
  @@map("kpi_targets")
}

model KpiActual {
  id           String        @id @default(uuid())
  definitionId String
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?         @relation("KpiActualUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  periodKey    String
  actualValue  Int           @default(0)
  note         String?
  recordedAt   DateTime      @default(now())

  @@unique([definitionId, userId, periodKey])
  @@map("kpi_actuals")
}

model PayrollPeriod {
  id         String    @id @default(uuid())
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  periodKey  String // "2026-08"
  status     String    @default("OPEN") // OPEN | CLOSED
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("PayrollCloser", fields: [closedById], references: [id], onDelete: SetNull)
  note       String?
  /// F17: lần tính gần nhất, tham số dùng khi tính (JSON) để xem lại căn cứ.
  computedAt DateTime?
  paramsJson String?
  createdAt  DateTime  @default(now())

  lines PayrollLine[]

  @@unique([branchId, periodKey])
  @@map("payroll_periods")
}

model PayrollLine {
  id       String        @id @default(uuid())
  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation("PayrollUser", fields: [userId], references: [id], onDelete: Restrict)

  baseSalary  Int     @default(0)
  commission  Int     @default(0)
  allowance   Int     @default(0)
  deduction   Int     @default(0)
  total       Int     @default(0)
  workedDays  Int     @default(0)
  note        String?
  /// F17: căn cứ tính (khách đến, doanh thu đã thu được tính, các khoản thưởng).
  roleCode    String?
  showups     Int     @default(0)
  revenue     Int     @default(0)
  salesBonus  Int     @default(0)
  upsellBonus Int     @default(0)
  adsBonus    Int     @default(0)
  detailJson  String?

  @@unique([periodId, userId])
  @@map("payroll_lines")
}

// =============================================================================
// TƯ VẤN & PHÁC ĐỒ · THƯ VIỆN CASE · MẪU BIỂU  (Giai đoạn 2, nhóm B1/B5)
// =============================================================================

model ConsultationSession {
  id           String   @id @default(uuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  consultantId String?
  consultant   User?    @relation("ConsultationConsultant", fields: [consultantId], references: [id], onDelete: SetNull)
  doctorId     String?
  doctor       User?    @relation("ConsultationDoctor", fields: [doctorId], references: [id], onDelete: SetNull)

  concernArea          String? // vùng quan tâm: "Bụng · Eo"
  expectation          String? // mong muốn bằng lời của khách
  budgetNote           String?
  readiness            String? // mức sẵn sàng
  recoveryNote         String? // thời gian nghỉ dưỡng khách chấp nhận được
  contraindicationNote String?
  note                 String?
  /// F30: vùng mặt (JSON mảng mã vùng: TRAN, MA, CAM, MOI, MUI, HOC_MAT, ...).
  faceAreas            String?
  /// F30: đề xuất dịch vụ, sản phẩm, liều (JSON mảng ConsultationProposal).
  proposals            String?
  /// F30: bộ ảnh "trước" chụp trong buổi tư vấn (PhotoSet mốc CONSULT).
  photoSetId           String?
  createdById          String?
  heldAt               DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plans TreatmentPlan[]

  @@index([customerId])
  @@map("consultation_sessions")
}

model TreatmentPlan {
  id         String               @id @default(uuid())
  branchId   String
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessionId  String?
  session    ConsultationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  doctorId   String?
  doctor     User?                @relation("TreatmentPlanDoctor", fields: [doctorId], references: [id], onDelete: SetNull)

  title          String
  method         String? // phương pháp chỉ định
  expectedResult String?
  riskNote       String?
  recoveryDays   Int?
  /// F30: báo giá lập từ phác đồ (một phác đồ một báo giá).
  quotationId    String?    @unique
  quotation      Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  note           String?
  createdById    String?
  status         String     @default("DRAFT") // DRAFT | PROPOSED | ACCEPTED | REJECTED
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items TreatmentPlanItem[]

  @@index([customerId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id          String        @id @default(uuid())
  planId      String
  plan        TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// F30: sản phẩm dùng, liều theo 0,1 đơn vị (15 = 1,5cc), số lượng báo giá, giá niêm yết lúc lập.
  productId   String?
  productName String?
  doseTenths  Int?
  quantity    Int           @default(1)
  listPrice   Int?
  faceArea    String?
  name        String
  stepOrder   Int           @default(1)
  note        String?

  @@map("treatment_plan_items")
}

model CaseStudy {
  id          String           @id @default(uuid())
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// Giữ liên kết khách để GỠ ĐƯỢC khi khách rút đồng ý — nhưng không bao giờ
  /// hiển thị ra ngoài. Phần công bố chỉ dùng các trường đã ẩn danh bên dưới.
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  procedureId String?
  procedure   ProcedureRecord? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorId    String?
  doctor      User?            @relation("CaseStudyDoctor", fields: [doctorId], references: [id], onDelete: SetNull)

  title       String
  /// Dữ liệu ĐÃ ẨN DANH: "Nữ, 32 tuổi" thay vì tên thật.
  anonymLabel String
  summary     String?
  beforeNote  String?
  afterNote   String?

  status                String    @default("DRAFT") // CaseStudyStatus
  /// Hai cổng duyệt: chuyên môn duyệt tính chính xác y khoa, truyền thông
  /// duyệt tính tuân thủ quảng cáo. Thiếu một trong hai là không xuất bản được.
  medicalApprovedById   String?
  medicalApprovedBy     User?     @relation("CaseMedicalApprover", fields: [medicalApprovedById], references: [id], onDelete: SetNull)
  medicalApprovedAt     DateTime?
  marketingApprovedById String?
  marketingApprovedBy   User?     @relation("CaseMarketingApprover", fields: [marketingApprovedById], references: [id], onDelete: SetNull)
  marketingApprovedAt   DateTime?
  publishedAt           DateTime?
  /// Khách rút đồng ý -> gỡ khỏi công bố, ghi lý do và thời điểm.
  withdrawnAt           DateTime?
  withdrawReason        String?

  createdById String?
  createdBy   User?    @relation("CaseStudyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, status])
  @@map("case_studies")
}

model ConsentTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  type      String   @default("SURGERY") // ConsentType
  title     String
  bodyText  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consent_templates")
}

// =============================================================================
// PANCAKE — GOM FACEBOOK · INSTAGRAM · TIKTOK · ZALO VỀ MỘT HỘP THƯ
// =============================================================================
//
// Vì sao đi qua Pancake thay vì nối thẳng từng nền tảng:
//   · TikTok KHÔNG có API nhắn tin công khai — nối thẳng là bất khả thi, không
//     phải khó. Pancake là đường duy nhất lấy được tin nhắn TikTok.
//   · Meta (Facebook/Instagram) đòi app review + xác minh doanh nghiệp, 2–6 tuần.
//   · Phòng khám đã trả tiền dùng Pancake cho các trang Facebook hiện có.
//
// Token Pancake mã hoá y như secret Zalo — nó mở được toàn bộ hội thoại khách.

model PancakeConfig {
  id               String    @id @default(uuid())
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  label            String
  /// Token API Pancake, mã hoá AES-256-GCM. Không bao giờ trả về máy khách.
  accessTokenEnc   String
  /// Bí mật ký webhook, nếu Pancake có cấu hình.
  webhookSecretEnc String?
  active           Boolean   @default(true)
  lastSyncAt       DateTime?
  lastSyncNote     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pages  PancakePage[]
  agents PancakeAgent[]

  @@map("pancake_configs")
}

model PancakePage {
  id                 String        @id @default(uuid())
  configId           String
  config             PancakeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// ID trang bên Pancake (ví dụ 172794895923921) — khoá để khử trùng lặp.
  pageId             String        @unique
  name               String
  /// FACEBOOK | INSTAGRAM | TIKTOK | ZALO — nguồn thật của hội thoại, dùng để
  /// quy doanh thu về đúng kênh khi tính ROAS.
  platform           String        @default("FACEBOOK")
  /// Gắn trang vào chiến dịch để nối tin nhắn ↔ chi phí quảng cáo.
  channelId          String?
  channel            Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  active             Boolean       @default(true)
  lastSyncAt         DateTime?
  /// Token riêng của trang (page_access_token), mã hoá AES-256-GCM.
  /// Mọi API cấp trang của Pancake (hội thoại, tin nhắn, thống kê) CHỈ nhận
  /// token này, không nhận token người dùng. Tự sinh từ token người dùng khi
  /// còn trống (POST /pages/{id}/generate_page_access_token) rồi lưu lại.
  pageAccessTokenEnc String?
  /// Lần kéo thống kê nhân viên gần nhất của trang (F35).
  statsSyncAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  conversations Conversation[]
  agentStats    PancakeAgentStat[]

  @@map("pancake_pages")
}

// =============================================================================
// F35 · BÁO CÁO HIỆU SUẤT NHÂN VIÊN TRÊN PANCAKE
//
// Pancake tự đo phần việc mà CRM không thấy được: nhân viên trả lời khách NGAY
// TRONG app Pancake thì CRM chỉ có bản sao tin nhắn, không biết ai bấm gửi.
// Nên số tin xử lý và tốc độ phản hồi lấy thẳng từ API thống kê của Pancake
// (GET /pages/{page_id}/statistics/users), kéo mỗi 10 phút.
// =============================================================================

/// Một nhân viên (user) bên Pancake, gắn với một tài khoản CRM để báo cáo quy
/// được về người thật. Chưa gắn thì vẫn báo cáo theo tên Pancake.
model PancakeAgent {
  id            String        @id @default(uuid())
  configId      String
  config        PancakeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  /// UUID user bên Pancake — khoá khử trùng lặp.
  pancakeUserId String
  name          String
  fbId          String?
  /// Tài khoản CRM tương ứng. Tự khớp theo tên khi dò, sửa tay được.
  userId        String?
  user          User?         @relation("PancakeAgentUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Pancake báo user này đã bị vô hiệu trong trang.
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([configId, pancakeUserId])
  @@index([userId])
  @@map("pancake_agents")
}

/// Một ô số liệu Pancake trả về: một nhân viên, một trang, một mốc giờ.
/// Ghi bằng upsert theo (pageId, pancakeUserId, hour) nên kéo lại cùng khoảng
/// thời gian không nhân đôi số — chỉ ghi đè bằng số mới nhất của Pancake.
model PancakeAgentStat {
  id                 String      @id @default(uuid())
  pageId             String
  page               PancakePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// UUID user bên Pancake (khớp PancakeAgent.pancakeUserId).
  pancakeUserId      String
  /// Mốc giờ ĐÃ QUY VỀ UTC. Pancake trả `hour` theo giờ địa phương của trang và
  /// `hour_in_integer` theo UTC — đọc bằng parseStatHour, đừng tự parse.
  hour               DateTime
  /// Ngày giờ Việt Nam của mốc giờ đó, "2026-10-08" — gom báo cáo theo ngày.
  dayKey             String
  /// Tin nhắn hộp thư nhân viên đã xử lý trong giờ đó.
  inboxCount         Int         @default(0)
  /// Bình luận đã xử lý.
  commentCount       Int         @default(0)
  /// Số hội thoại riêng biệt đã trả lời (không phải số tin).
  uniqueInboxCount   Int         @default(0)
  uniqueCommentCount Int         @default(0)
  /// Tin trả lời riêng gửi ra từ một bình luận.
  privateReplyCount  Int         @default(0)
  /// Số điện thoại lấy được.
  phoneNumberCount   Int         @default(0)
  /// Tốc độ phản hồi trung bình trong giờ đó, GIÂY.
  /// Tài liệu Pancake ghi miligiây là SAI: dữ liệu thật có trung vị 437 — đọc
  /// là giây thì ra 7,3 phút (hợp lý), đọc là ms thì ra 0,44 giây (vô lý).
  /// 0 = Pancake không đo được giờ đó, KHÔNG phải trả lời tức thì.
  avgResponseSeconds Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([pageId, pancakeUserId, hour])
  @@index([dayKey])
  @@index([pancakeUserId, dayKey])
  @@map("pancake_agent_stats")
}

// -----------------------------------------------------------------------------
// CHUYỂN KHO CÓ DUYỆT · ĐỊNH MỨC VẬT TƯ THEO DỊCH VỤ
// -----------------------------------------------------------------------------

model StockTransfer {
  id              String    @id @default(uuid())
  code            String    @unique
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  /// PENDING -> APPROVED -> COMPLETED, hoặc REJECTED.
  /// Hàng CHỈ rời kho khi COMPLETED — duyệt xong mà chưa xuất thì tồn chưa đổi,
  /// nhờ vậy thẻ kho luôn khớp với hàng thật trên kệ.
  status        String    @default("PENDING")
  reason        String?
  requestedById String?
  requestedBy   User?     @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?     @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  completedAt   DateTime?
  rejectNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items StockTransferItem[]

  @@index([branchId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Chuyển theo LÔ chứ không chỉ theo số lượng — nếu không thì sang kho con
  /// là mất dấu hạn dùng và mất luôn khả năng truy vết.
  lotId      String?
  lot        StockLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)
  quantity   Int

  @@map("stock_transfer_items")
}

model ServiceMaterial {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Định mức tiêu hao cho MỘT lần thực hiện dịch vụ.
  quantity  Int      @default(1)
  /// Bắt buộc: thiếu vật tư này thì cảnh báo trước khi mổ.
  required  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@unique([serviceId, productId])
  @@map("service_materials")
}

// =============================================================================
// LÔ 4 · ĐỢT 2: TỰ ĐỘNG HOÁ VÀ BÁN HÀNG
// =============================================================================

// F8: mỗi lần chạy một tác vụ nền.
model JobRun {
  id            String    @id @default(uuid())
  jobKey        String
  /// JobRunStatus: RUNNING | SUCCESS | FAILED
  status        String    @default("RUNNING")
  /// JobTrigger: SCHEDULE | MANUAL
  trigger       String    @default("SCHEDULE")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  createdCount  Int       @default(0)
  message       String?
  error         String?
  triggeredById String?

  @@index([jobKey, startedAt])
  @@index([startedAt])
  @@map("job_runs")
}

// F8: khoá chạy tác vụ (một tác vụ không chạy chồng, kể cả khi có hai tiến trình).
model JobLock {
  key         String   @id
  owner       String
  lockedUntil DateTime

  @@map("job_locks")
}

// F9: dấu "đã xử lý" của quy tắc tự động cho một đối tượng, để không sinh việc trùng.
model AutomationMark {
  id        String   @id @default(uuid())
  ruleKey   String
  dedupeKey String
  createdAt DateTime @default(now())

  @@unique([ruleKey, dedupeKey])
  @@map("automation_marks")
}

// F26: con trỏ chia hội thoại xoay vòng theo cơ sở.
model RoundRobinState {
  key        String   @id
  lastUserId String?
  updatedAt  DateTime @updatedAt

  @@map("round_robin_states")
}

// F26: nhãn và ghi chú nội bộ của hội thoại (cột 3 hộp thư).
model ConversationTag {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, tagId])
  @@map("conversation_tags")
}

model ConversationNote {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  userName       String?
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

// F11: nhóm khách lưu sẵn (bộ lọc JSON).
model CustomerSegment {
  id          String   @id @default(uuid())
  name        String
  filter      String // JSON SegmentFilter
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_segments")
}

// F11: một lần gửi tin theo kịch bản cho một nhóm khách.
model Broadcast {
  id            String    @id @default(uuid())
  name          String
  branchId      String?
  segmentId     String?
  filter        String // JSON SegmentFilter đã dùng
  template      String
  /// BroadcastStatus: QUEUED | RUNNING | DONE | CANCELLED
  status        String    @default("QUEUED")
  total         Int       @default(0)
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  recipients BroadcastRecipient[]

  @@index([status, createdAt])
  @@map("broadcasts")
}

// F11: nhật ký gửi từng khách.
model BroadcastRecipient {
  id             String    @id @default(uuid())
  broadcastId    String
  broadcast      Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId     String
  conversationId String?
  /// RecipientStatus: PENDING | SENT | FAILED | SKIPPED_OPT_OUT | TASK_CREATED | CANCELLED
  status         String    @default("PENDING")
  content        String?
  error          String?
  taskId         String?
  messageId      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([broadcastId, status])
  @@index([status, sentAt])
  @@index([customerId])
  @@map("broadcast_recipients")
}

// F13: đợt ưu đãi.
model Promotion {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  /// PromotionKind: PERCENT (value = %) | AMOUNT (value = đồng / đơn vị)
  kind        String    @default("PERCENT")
  value       Int
  /// Số suất; trống = không giới hạn. Hết suất thì tự khoá.
  maxSlots    Int?
  usedSlots   Int       @default(0)
  startAt     DateTime
  endAt       DateTime
  /// Trống = áp dụng mọi cơ sở.
  branchId    String?
  active      Boolean   @default(true)
  lockedAt    DateTime?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services PromotionService[]

  @@index([active, startAt, endAt])
  @@map("promotions")
}

model PromotionService {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([promotionId, serviceId])
  @@map("promotion_services")
}

// AI2: kịch bản bán hàng chuẩn, có phiên bản.
model SalesScript {
  id            String   @id @default(uuid())
  key           String   @default("default")
  version       Int
  title         String
  content       String
  isActive      Boolean  @default(false)
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([key, version])
  @@map("sales_scripts")
}

// AI2: mỗi lần gợi ý câu trả lời, kèm câu thực gửi để đối chiếu.
model AiSuggestion {
  id             String    @id @default(uuid())
  conversationId String
  customerId     String?
  userId         String?
  userName       String?
  /// AiSuggestionStatus
  status         String
  reason         String?
  suggestion     String?
  scriptId       String?
  model          String?
  checkResult    String? // JSON kết quả tự kiểm
  sentMessageId  String?
  sentText       String?
  sentAt         DateTime?
  edited         Boolean?
  createdAt      DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@index([customerId])
  @@map("ai_suggestions")
}

// =============================================================================

// F18: quản lý gắn cờ vi phạm chuyên môn cho nhân viên trong tháng (loại khỏi thi đua).
model StaffViolationFlag {
  id            String    @id @default(uuid())
  userId        String
  branchId      String?
  periodKey     String // "2026-10"
  reason        String
  flaggedById   String?
  flaggedByName String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedById   String?

  @@index([periodKey, userId])
  @@map("staff_violation_flags")
}

// F20: voucher gắn khách, dùng khi thanh toán.
model Voucher {
  id                String    @id @default(uuid())
  code              String    @unique
  customerId        String?
  branchId          String?
  value             Int // đồng
  expiresAt         DateTime
  /// VoucherStatus: ACTIVE | REDEEMED | CANCELLED (hết hạn tính theo expiresAt)
  status            String    @default("ACTIVE")
  /// VoucherSource: MANUAL | REFERRAL | BIRTHDAY | GIFT
  source            String    @default("MANUAL")
  note              String?
  createdById       String?
  createdAt         DateTime  @default(now())
  redeemedAt        DateTime?
  redeemedById      String?
  redeemedPaymentId String?

  @@index([customerId])
  @@index([status, expiresAt])
  @@map("vouchers")
}

// F19: thưởng giới thiệu, mỗi khách được giới thiệu chỉ sinh MỘT lần thưởng.
model ReferralReward {
  id          String    @id @default(uuid())
  /// Khách được giới thiệu (người mới).
  customerId  String    @unique
  referrerId  String
  procedureId String?
  /// ReferralRewardKind: VOUCHER | CASH
  kind        String
  amount      Int
  voucherId   String?
  /// ReferralRewardStatus: ISSUED (đã phát voucher) | PENDING_PAYOUT (chờ chi tiền) | PAID
  status      String
  paidAt      DateTime?
  paidById    String?
  createdAt   DateTime  @default(now())

  @@index([referrerId])
  @@map("referral_rewards")
}

// F20: danh mục quà tặng khi khách ra về, nhật ký tặng quà.
model GiftItem {
  id        String   @id @default(uuid())
  name      String
  cost      Int // đồng mỗi đơn vị
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gift_items")
}

model GiftLog {
  id          String   @id @default(uuid())
  customerId  String
  branchId    String
  giftItemId  String
  giftName    String
  quantity    Int      @default(1)
  unitCost    Int
  totalCost   Int
  visitId     String?
  givenById   String?
  givenByName String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([branchId, createdAt])
  @@map("gift_logs")
}

// F34: chỉ tiêu doanh thu theo tháng, cơ sở, dịch vụ. scopeKey = "YYYY-MM|branchId|serviceId" (* = tất cả).
model SalesTarget {
  id            String   @id @default(uuid())
  scopeKey      String   @unique
  periodKey     String
  branchId      String?
  serviceId     String?
  targetRevenue Int      @default(0)
  targetShowups Int?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([periodKey])
  @@map("sales_targets")
}

// AI4: điểm chấm hội thoại theo kịch bản mỗi tuần (không trừ lương tự động).
model ConversationScore {
  id             String   @id @default(uuid())
  conversationId String
  customerId     String?
  /// Sale phụ trách hội thoại lúc chấm.
  userId         String?
  branchId       String?
  weekKey        String // "2026-W40"
  scriptId       String?
  scriptVersion  Int?
  /// ConversationScoreStatus: SCORED | FAILED
  status         String
  score          Int?
  criteriaJson   String?
  summary        String?
  model          String?
  error          String?
  createdAt      DateTime @default(now())

  @@unique([conversationId, weekKey])
  @@index([weekKey, userId])
  @@index([customerId])
  @@map("conversation_scores")
}

// =============================================================================
// Lô 6 · SAU 90 NGÀY

// AI5: nháp tin chăm lại khách im lặng, chờ sale duyệt. Không bao giờ tự gửi:
// duyệt xong mới vào hàng đợi gửi theo nhóm (F11), tôn trọng optOut và cửa sổ 24 giờ.
model ReengageDraft {
  id             String    @id @default(uuid())
  customerId     String
  branchId       String?
  conversationId String?
  /// Sale phụ trách lúc soạn (người được giao duyệt).
  ownerId        String?
  /// Ngày soạn theo giờ VN "2026-10-02".
  dayKey         String
  content        String
  model          String?
  /// ReengageDraftStatus: PENDING | QUEUED | REJECTED | EXPIRED
  status         String    @default("PENDING")
  /// Nội dung sale đã sửa trước khi duyệt (trống = giữ nguyên nháp AI).
  finalContent   String?
  edited         Boolean   @default(false)
  broadcastId    String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@index([customerId])
  @@map("reengage_drafts")
}

// AI6: bản tin sáng cho quản lý, chỉ từ số liệu tổng hợp (không có thông tin cá nhân khách).
model ManagerBriefing {
  id          String   @id @default(uuid())
  dayKey      String
  /// "ALL" = toàn hệ thống, còn lại là id cơ sở.
  scopeKey    String
  branchId    String?
  /// BriefingSource: AI | FALLBACK
  source      String
  content     String
  metricsJson String
  model       String?
  createdAt   DateTime @default(now())

  @@unique([dayKey, scopeKey])
  @@map("manager_briefings")
}

// =============================================================================
// Lô 7 · CRM 360 LÔ A
// =============================================================================

// V2: luật gợi ý bán kèm (dịch vụ A -> gợi ý B). Quản lý cơ sở, giám đốc quản lý
// (upsell.manage); luật mẫu do đội code đặt phải được bác sĩ duyệt nội dung (upsell.review).
model UpsellRule {
  id               String    @id @default(uuid())
  /// Cơ sở áp dụng; trống = mọi cơ sở.
  branchId         String?
  triggerServiceId String
  triggerService   Service   @relation("UpsellTrigger", fields: [triggerServiceId], references: [id], onDelete: Cascade)
  suggestServiceId String
  suggestService   Service   @relation("UpsellSuggest", fields: [suggestServiceId], references: [id], onDelete: Cascade)
  /// Lời gợi ý cho tư vấn viên nói với khách.
  pitch            String
  /// Điều kiện áp dụng bằng lời (bác sĩ đánh giá...), hiện kèm gợi ý.
  conditionNote    String?
  /// Chỉ gợi ý khi khách chưa từng làm dịch vụ B (lần thực hiện hoàn tất hoặc hợp đồng).
  onlyIfNotDone    Boolean   @default(true)
  priority         Int       @default(0)
  active           Boolean   @default(true)
  /// Luật mẫu, chờ bác sĩ duyệt chuyên môn.
  isSample         Boolean   @default(false)
  reviewedById     String?
  reviewedAt       DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  offers UpsellOffer[]

  @@index([triggerServiceId, active])
  @@map("upsell_rules")
}

// V2: mỗi lần gợi ý bán kèm cho một khách và kết quả (khách nhận / từ chối), để đo tỉ lệ.
model UpsellOffer {
  id               String      @id @default(uuid())
  ruleId           String?
  rule             UpsellRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId         String?
  triggerServiceId String?
  suggestServiceId String
  /// UpsellContext: CONSULT | COUNTER | INBOX | QUOTE
  context          String
  /// UpsellOfferStatus: SUGGESTED | ACCEPTED | DECLINED
  status           String      @default("SUGGESTED")
  declineReason    String?
  quotationId      String?
  suggestedById    String?
  suggestedAt      DateTime    @default(now())
  decidedById      String?
  decidedAt        DateTime?

  @@index([customerId, status])
  @@index([ruleId, status])
  @@index([suggestedAt])
  @@map("upsell_offers")
}

// =============================================================================
// Lô 8 · CRM 360 LÔ B
// =============================================================================

// P6: cơ hội bán. Một khách có thể có nhiều cơ hội (khách đã làm dịch vụ quay lại
// hỏi dịch vụ mới thì mở cơ hội mới). Bước của khách (Customer.stage) luôn bằng
// bước của cơ hội đang mở mới nhất, không có cơ hội mở thì bằng cơ hội gần nhất.
model Opportunity {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId        String?
  /// Dịch vụ quan tâm chính (có thể trống: cơ hội cũ chuyển từ khách).
  serviceId       String?
  title           String
  stage           String
  /// P4: bước con (ví dụ LICH_COC: HEN_CHUA_COC | DA_COC).
  subStage        String?
  stageChangedAt  DateTime?
  /// OpportunityStatus: OPEN | WON | LOST
  status          String    @default("OPEN")
  /// Giá trị dự kiến nhập tay (đồng); trống = tính từ báo giá, phác đồ, dịch vụ quan tâm.
  expectedValue   Int?
  /// V7: ngày dự kiến chốt (gom dự báo theo tháng).
  expectedCloseAt DateTime?
  channelId       String?
  campaignId      String?
  /// Sale phụ trách cơ hội.
  ownerId         String?
  lostReason      String?
  lostNote        String?
  closedAt        DateTime?
  /// OpportunitySource: MIGRATION | AUTO | MANUAL
  source          String    @default("MANUAL")
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stageHistory StageHistory[]

  @@index([customerId, status])
  @@index([stage, status])
  @@index([ownerId])
  @@map("opportunities")
}

// J3: checklist việc theo bước. Vào bước thì tự sinh việc cho sale phụ trách.
model StageChecklistItem {
  id              String   @id @default(uuid())
  stage           String
  /// Cơ sở áp dụng; trống = mọi cơ sở.
  branchId        String?
  title           String
  /// Mẫu tin gợi ý gửi khách ở bước này (không tự gửi).
  messageTemplate String?
  /// Hạn việc: số ngày sau khi vào bước (0 = trong ngày).
  dueDays         Int      @default(0)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  isSample        Boolean  @default(false)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stage, active])
  @@map("stage_checklist_items")
}

// V3: gói liệu trình nhiều buổi trả trước. Bán qua hợp đồng như mọi dịch vụ (doanh
// số và thực thu giữ nguyên cách ghi cũ); gói theo dõi buổi đã dùng, còn lại.
model TreatmentPackage {
  id             String    @id @default(uuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId       String
  contractId     String
  contractItemId String    @unique
  serviceId      String?
  name           String
  totalSessions  Int
  usedSessions   Int       @default(0)
  /// Giá trị gói (đồng) = thành tiền dòng hợp đồng lúc lập gói.
  price          Int
  /// Số ngày giữa hai buổi để nhắc đặt buổi tiếp; trống = tham số chung.
  intervalDays   Int?
  expiresAt      DateTime?
  /// PackageStatus: ACTIVE | COMPLETED | CANCELLED
  status         String    @default("ACTIVE")
  cancelReason   String?
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions PackageSession[]

  @@index([customerId, status])
  @@index([status, lastUsedAt])
  @@map("treatment_packages")
}

model PackageSession {
  id          String           @id @default(uuid())
  packageId   String
  package     TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sessionNo   Int
  usedAt      DateTime         @default(now())
  procedureId String?          @unique
  visitId     String?
  /// Giá trị buổi (đồng) = giá gói chia đều, buổi cuối nhận phần dư. Chỉ để tham khảo, không vào báo cáo doanh thu.
  value       Int
  note        String?
  userId      String?
  userName    String?
  createdAt   DateTime         @default(now())

  @@unique([packageId, sessionNo])
  @@map("package_sessions")
}
