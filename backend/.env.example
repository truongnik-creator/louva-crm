# Mọi biến đều TUỲ CHỌN khi chạy trên máy phát triển: không có tệp .env phần
# mềm vẫn chạy (SQLite tự tạo, migration tự áp, khoá mã hoá tự sinh).
# Chép tệp này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên git.
# Ở production (NODE_ENV=production) các dòng đánh dấu [BẮT BUỘC] phải có.

# ------------------------------------------------------------ MÔI TRƯỜNG
# NODE_ENV=production
PORT=4000
# Tên miền được gọi API từ trình duyệt khác origin (bản web do chính backend
# phục vụ thì không cần). Nhiều giá trị cách nhau dấu phẩy.
# CORS_ORIGIN="http://localhost:5173"
# Chỉ tin X-Forwarded-For từ proxy chạy cùng máy (cloudflared, nginx cục bộ).
# TRUST_PROXY="loopback"
# LOG_LEVEL="info"
# Múi giờ nghiệp vụ cho mọi gom ngày, tháng.
# BUSINESS_TZ="Asia/Ho_Chi_Minh"

# ------------------------------------------------------------ CƠ SỞ DỮ LIỆU
# Mặc định: backend/data/crm.db (tự tạo lần chạy đầu).
# DATABASE_URL="file:./data/crm.db"
# Thư mục tệp đã mã hoá (ảnh, chữ ký, tệp đính kèm chat).
# STORAGE_DIR="./data/storage"

# ------------------------------------------------------------ XÁC THỰC
# [BẮT BUỘC ở production] tối thiểu 32 ký tự ngẫu nhiên. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# JWT_SECRET=""
# ACCESS_TOKEN_TTL="15m"
# REFRESH_TOKEN_DAYS=7
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Tài khoản quản trị tạo ở lần khởi động đầu. Không đặt mật khẩu thì production
# tự sinh ngẫu nhiên và in ra một lần.
# ADMIN_EMAIL="admin@louva.vn"
# ADMIN_PASSWORD=""

# ------------------------------------------------------------ KHOÁ MÃ HOÁ
# Ưu tiên: ENCRYPTION_KEY (64 ký tự hex) rồi đến tệp ENCRYPTION_KEY_FILE.
# Khuyến nghị đặt tệp khoá NGOÀI thư mục data và sao lưu khoá RIÊNG.
# ENCRYPTION_KEY_FILE="/etc/louva/enc-key"
# ENCRYPTION_KEY=""

# ------------------------------------------------------------ SAO LƯU
# BACKUP_DIR="./backups"
# BACKUP_KEEP=14
# Bỏ bước tự sao lưu trước khi migrate (chỉ dùng cho test).
# SKIP_PREMIGRATE_BACKUP=1

# ------------------------------------------------------------ PHÒNG KHÁM
# Tên, mã cơ sở đầu tiên khi CSDL còn trống (sau đó sửa ở màn Cài đặt).
# CLINIC_NAME="Phòng khám Thẩm mỹ Louva"
# CLINIC_SHORT_NAME="Louva"
# CLINIC_CODE="LOUVA"
# Giới hạn số dòng mỗi lần xuất dữ liệu khách (xuất kế toán F33 đi theo trang, không bị giới hạn này).
# EXPORT_ROW_LIMIT=5000
# Số phút quyền xem bệnh án khẩn cấp (break-glass).
# BREAK_GLASS_MINUTES=30
# Tắt bộ hẹn giờ tác vụ nền (khi chạy thêm tiến trình thử nghiệm trên cùng CSDL).
# DISABLE_JOBS=1

# ------------------------------------------------------------ SEED DỮ LIỆU MẪU
# SEED_DEMO=1                  tạo tài khoản và khách demo (không có thì chỉ nạp danh mục)
# SEED_DEMO_KEEP_PASSWORD=1    không buộc đổi mật khẩu demo (chỉ máy cá nhân, bị bỏ qua ở production)
# SEED_DEMO_PASSWORD=""        mật khẩu chung cho tài khoản demo (production: tối thiểu 10 ký tự)

# ------------------------------------------------------------ ZALO
# Chạy được khi để trống; Zalo OA khai trong app (Cài đặt, Kết nối Zalo).
ZALO_OAUTH_REDIRECT_URI="http://localhost:4000/api/zalo/oauth/callback"

# ------------------------------------------------------------ AI (Claude)
# Khoá Claude API cho AI1 tách thông tin, AI2 gợi ý trả lời, AI3 tóm tắt, AI4
# chấm hội thoại, AI5 nháp tin chăm lại, AI6 bản tin sáng. Để trống thì mọi tính
# năng AI tự tắt, giao diện báo "chưa cấu hình", nghiệp vụ không lỗi (AI6 gửi
# bản số liệu thuần). KHÔNG ghi khoá thật vào repo.
# ANTHROPIC_API_KEY=""

# ------------------------------------------------------------ PANCAKE (F5)
# Bí mật xác thực webhook Pancake dùng chung (kết nối nào có bí mật riêng trong
# Cài đặt thì dùng cái đó). Pancake gửi header X-Pancake-Signature (HMAC-SHA256
# thân yêu cầu) hoặc X-Webhook-Secret. TODO-VERIFY với tài liệu Pancake thật.
# PANCAKE_WEBHOOK_SECRET=""
# Cách gửi token: header (mặc định) hoặc query nếu Pancake chỉ nhận ?access_token=.
# PANCAKE_TOKEN_MODE="header"
# PANCAKE_API_BASE="https://pages.fm/api/v1"

# ------------------------------------------------------------ NHẬN CỌC (F25)
# Giá trị mặc định cho Cài đặt hệ thống, nhóm Đặt cọc (sửa được trên giao diện;
# cơ sở có tài khoản riêng thì khai ở Thông tin cơ sở).
# BANK_BIN=""            # mã BIN 6 số của ngân hàng theo napas, ví dụ 970436
# BANK_ACCOUNT_NO=""
# BANK_ACCOUNT_NAME=""   # viết hoa không dấu như trên thẻ
