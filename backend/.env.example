# All of these are optional — the app runs with zero configuration and no
# .env file at all. Copy this to .env only if you want to override a default.

# SQLite database file. Defaults to an absolute path inside this backend's
# own data/ directory (created automatically on first boot) — no database
# server to install, no manual migration/seed commands to run.
# DATABASE_URL="file:./data/crm.db"

# Auth. If unset, a fixed development secret is used so JWTs stay valid
# across restarts. Set this before exposing the server to the internet.
# JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Zalo OAuth (optional — the app runs fine with this unset; Zalo endpoints
# simply no-op until an Official Account is configured in-app).
ZALO_OAUTH_REDIRECT_URI="http://localhost:4000/api/zalo/oauth/callback"
